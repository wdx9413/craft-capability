{
  "name": "craft-capability",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for independently packaged Craft capabilities",
  "scripts": {
    "typecheck:datasec": "pnpm --filter @craft/capability-datasec typecheck",
    "build": "pnpm --filter @craft/capability-knowledge --filter @craft/capability-memory --filter @craft/capability-experience --filter @craft/capability-codebase --filter @craft/capability-datasec --filter @craft/craft-notes run build",
    "typecheck": "pnpm --filter \"./capability/**\" run typecheck",
    "test:coverage": "py scripts/coverage-inventory.py",
    "test:coverage:list": "py scripts/coverage-inventory.py --list",
    "test:e2e": "node ../.tools/verify-craft-coverage.mjs"
  },
  "engines": {
    "node": ">=23"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^24.0.0"
  },
  "packageManager": "pnpm@11.19.0"
}
