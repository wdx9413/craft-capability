{
  "name": "@craft/capability-datasec",
  "version": "0.1.7",
  "description": "Independent local text redaction hooks for Claude Code and Codex",
  "type": "module",
  "main": "./dist/rules.js",
  "types": "./dist/rules.d.ts",
  "exports": {
    ".": {
      "types": "./dist/rules.d.ts",
      "default": "./dist/rules.js"
    },
    "./hook": {
      "types": "./dist/hook.d.ts",
      "default": "./dist/hook.js"
    },
    "./rules": {
      "types": "./dist/rules.d.ts",
      "default": "./dist/rules.js"
    },
    "./vault": {
      "types": "./dist/vault.d.ts",
      "default": "./dist/vault.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 --test-coverage-include=rules.ts tests/rules.test.ts"
  },
  "engines": {
    "node": ">=23"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wdx9413/craft-capability.git"
  },
  "homepage": "https://github.com/wdx9413/craft-capability#readme",
  "bugs": {
    "url": "https://github.com/wdx9413/craft-capability/issues"
  },
  "license": "MIT"
}
