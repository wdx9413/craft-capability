{
  "name": "@craft/capability-datasec",
  "version": "0.1.6",
  "private": true,
  "description": "Independent local text redaction hooks for Claude Code and Codex",
  "type": "module",
  "main": "./dist/rules.js",
  "types": "./dist/rules.d.ts",
  "exports": {
    ".": {
      "types": "./dist/capability.d.ts",
      "default": "./dist/capability.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./hook": {
      "types": "./dist/hook.d.ts",
      "default": "./dist/hook.js"
    },
    "./rules": {
      "types": "./dist/rules.d.ts",
      "default": "./dist/rules.js"
    },
    "./vault": {
      "types": "./dist/vault.d.ts",
      "default": "./dist/vault.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test ../../tests/craft-datasec.test.ts"
  },
  "engines": {
    "node": ">=23"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
