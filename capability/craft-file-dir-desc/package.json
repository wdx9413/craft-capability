{
  "name": "@craft/capability-file-dir-desc",
  "version": "0.20.4",
  "description": "Craft Notes: an evolving registry of human-readable notes for directories across devices",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./file-dir-desc": {
      "types": "./dist/file-dir-desc.d.ts",
      "default": "./dist/file-dir-desc.js"
    },
    "./index": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "craft-common-store-local": "0.20.4",
    "craft-common-base": "0.20.4"
  },
  "engines": {
    "node": ">=23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wdx9413/craft-capability.git"
  },
  "homepage": "https://github.com/wdx9413/craft-capability#readme",
  "bugs": {
    "url": "https://github.com/wdx9413/craft-capability/issues"
  },
  "license": "MIT"
}
