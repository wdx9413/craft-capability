{
  "name": "@craft/capability-file-dir-desc",
  "version": "0.20.4",
  "private": true,
  "description": "Self-evolving registry that maps directories to human-readable semantic descriptions",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/capability.d.ts",
      "default": "./dist/capability.js"
    },
    "./file-dir-desc": {
      "types": "./dist/file-dir-desc.d.ts",
      "default": "./dist/file-dir-desc.js"
    },
    "./index": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "craft-common-store-local": "0.20.4",
    "craft-common-base": "0.20.4"
  },
  "engines": {
    "node": ">=23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "types": "./dist/index.d.ts"
}
